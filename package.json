{
  "name": "autoskip",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:package": "node --test tests/package-extension.check.mjs",
    "build": "tsc -b && vite build && vite build -c vite.content.config.ts && vite build -c vite.background.config.ts && node scripts/package-extension.mjs dist",
    "build:firefox": "tsc -b && node scripts/build-firefox.mjs",
    "test:firefox-build": "node --test tests/firefox-build.check.mjs",
    "test": "playwright test --project=regression",
    "test:live": "playwright test --project=youtube-live",
    "build:dev": "vite build --mode development && vite build -c vite.content.config.ts --mode development && vite build -c vite.background.config.ts --mode development && node scripts/package-extension.mjs dist",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.3.8"
  }
}
